NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=clarity_docs
DB_SSL=false

# Google Gemini (primary — free)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (fallback — free tier, single key for all models)
# Get your free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter free models in priority order
OPENROUTER_MODEL_PRIMARY=google/gemma-4-31b-it:free
OPENROUTER_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL_TERTIARY=nvidia/nemotron-3-ultra-550b-a55b:free

# Future paid upgrades (uncomment and add keys when ready)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Swagger
SWAGGER_TITLE=ClarityDocs API
SWAGGER_DESCRIPTION=AI-powered document intelligence platform
SWAGGER_VERSION=1.0

JWT_SECRET=minimum-32-character-secret-key-here
JWT_EXPIRES_IN=24h

ADMIN_EMAIL=admin@claritydocs.com
ADMIN_PASSWORD=your_secure_password_here

THROTTLE_TTL=60
THROTTLE_LIMIT=30

FRONTEND_URL=http://localhost:5173

CONFIDENCE_REVIEW_THRESHOLD=0.75