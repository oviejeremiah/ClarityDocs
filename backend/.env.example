# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=clarity_docs

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Swagger
SWAGGER_TITLE=ClarityDocs API
SWAGGER_DESCRIPTION=AI-powered document intelligence platform
SWAGGER_VERSION=1.0